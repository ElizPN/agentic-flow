enum UserRole {
  PARTICIPANT
  ADMIN

  @@map("user_role")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  role          UserRole @default(PARTICIPANT)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // TODO: add relations once these models exist:
  // Better Auth: sessions Session[], accounts Account[]
  // App: hackathons Hackathon[], hackathonParticipants HackathonParticipant[]

  @@map("user")
}
